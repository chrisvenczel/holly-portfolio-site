---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Events & Classes | Holly Alaine Arts">
  <section class="events-page">
    <h1>Events &amp; Classes</h1>

    <!-- ── Seniors ───────────────────────────────── -->
    <div class="events-category">
      <h2 class="category-label">For Ages 55+</h2>

      <div class="event-card">
        <div class="event-location">Abbotsford &mdash; The Glebe Centre, Craft Room</div>
        <h3 class="event-title">Painting &amp; Drawing</h3>
        <p class="event-schedule">Wednesdays &nbsp;9:30 &ndash; 11:30 am</p>
        <p class="event-dates">Sept 9 &ndash; Nov 18 &nbsp;&middot;&nbsp; 10 weeks &nbsp;&middot;&nbsp; No class Oct 14</p>
      </div>

      <div class="event-card">
        <div class="event-location">Abbotsford &mdash; The Glebe Centre, Craft Room</div>
        <h3 class="event-title">Card Making Workshops</h3>
        <p class="event-schedule">Mondays &nbsp;9:30 &ndash; 11:30 am</p>
        <ul class="event-sessions">
          <li><span class="session-date">Sept 14</span> &mdash; Thanksgiving Card</li>
          <li><span class="session-date">Oct 19</span> &mdash; Birthday Card</li>
          <li><span class="session-date">Nov 16</span> &mdash; Holiday Card</li>
        </ul>
      </div>
    </div>

    <!-- ── Children ──────────────────────────────── -->
    <div class="events-category">
      <h2 class="category-label">For Children</h2>
      <p class="category-location">In person at the Glebe Neighbourhood Activity Group (GNAG)</p>

      <div class="event-card">
        <h3 class="event-title">Fashion Design Drawing &amp; Basic Sewing Skills</h3>
        <p class="event-grade">Grades 6&ndash;9</p>
        <p class="event-schedule">Saturdays &nbsp;11:00 am &ndash; 1:00 pm</p>
        <p class="event-dates">Sept 26 &ndash; Dec 5 &nbsp;&middot;&nbsp; No class Oct 10</p>
        <p class="event-desc">This class will combine figure drawing basics and fashion illustration drawing
with practical skills like mending holes in your clothing, and embroidery basics!
</p>
      </div>

      <div class="event-card">
        <h3 class="event-title">Magical &amp; Realistic Animal Drawing</h3>
        <p class="event-grade">Grades 5&ndash;8</p>
        <p class="event-schedule">Saturdays &nbsp;9:00 &ndash; 10:45 am</p>
        <p class="event-dates">Sept 26 &ndash; Dec 5 &nbsp;&middot;&nbsp; No class Oct 10</p>
        <p class="event-desc">We will draw a different animal every week! We will learn how to draw both
magical and realistic animals using graphite pencils, colored pencils, and markers. 
</p>
      </div>
    </div>

    <!-- ── Online ─────────────────────────────────── -->
    <div class="events-category">
      <h2 class="category-label">Online Art Classes for Children</h2>
      <p class="category-location">Miss Jenny&rsquo;s Studio on Outschool</p>
      <a
        class="btn"
        href="https://outschool.com/teachers/Missjennysstudio"
        target="_blank"
        rel="noopener noreferrer"
      >
        Browse Classes on Outschool
      </a>
    </div>
  </section>
</Layout>

<style>
  .events-page {
    max-width: 42rem;
    padding: 2rem 0 1rem;
  }

  .events-page h1 {
    font-family: var(--font-serif);
    font-size: clamp(1.85rem, 3.5vw, 2.4rem);
    margin: 0 0 2.5rem;
    letter-spacing: -0.01em;
  }

  .events-category {
    margin-bottom: 3rem;
  }

  .category-label {
    font-family: var(--font-serif);
    font-size: 1.35rem;
    font-weight: 600;
    margin: 0 0 0.25rem;
    color: var(--text);
  }

  .category-location {
    color: var(--muted);
    font-size: 0.95rem;
    margin: 0 0 1.25rem;
  }

  .event-card {
    border-left: 3px solid var(--accent);
    padding: 1rem 1.25rem;
    margin-bottom: 1.25rem;
    background: #f4f2ec;
    border-radius: 0 6px 6px 0;
  }

  .event-location {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--muted);
    margin-bottom: 0.4rem;
  }

  .event-title {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    font-weight: 600;
    margin: 0 0 0.5rem;
  }

  .event-grade {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--links);
    margin: 0 0 0.35rem;
  }

  .event-schedule {
    margin: 0 0 0.2rem;
    font-weight: 500;
  }

  .event-dates {
    margin: 0 0 0.5rem;
    color: var(--muted);
    font-size: 0.95rem;
  }

  .event-desc {
    margin: 0.5rem 0 0;
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.65;
  }

  .event-sessions {
    list-style: none;
    padding: 0;
    margin: 0.35rem 0 0;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .event-sessions li {
    font-size: 0.95rem;
    color: var(--muted);
  }

  .session-date {
    font-weight: 600;
    color: var(--text);
  }

  .btn {
    display: inline-block;
    margin-top: 0.5rem;
    padding: 0.65rem 1.5rem;
    background: var(--links);
    color: #fff;
    text-decoration: none;
    border-radius: 5px;
    font-weight: 600;
    font-size: 0.95rem;
    transition: background 0.15s;
  }

  .btn:hover {
    background: #195f2e;
  }
</style>
