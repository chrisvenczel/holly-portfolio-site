---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const featuredImage = `${base}/images/featured.png`;
---

<Layout title="Holly Alaine Arts | Portfolio">
  <section class="hero hero--split">
    <div class="hero-text">
      <h1>Holly Alaine Staples</h1>
      <p class="hero-tagline">Art educator & artist in Ottawa, ON</p>
      <div class="hero-about">
        <h2>About</h2>
        <p>
          Available for custom art, art education, face/body painting and live art performances.
        </p>
      </div>
    </div>
    <figure class="hero-image">
      <img src={featuredImage} alt="Holly Alaine Staples in her studio, surrounded by her artwork" />
    </figure>
  </section>
</Layout>
