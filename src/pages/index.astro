---
import Layout from '../layouts/Layout.astro';

const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const featuredImage = `${base}/images/featured.png`;

const navCards = [
  { href: `${base}/gallery`,   label: 'Art Gallery',           bg: `${base}/images/nav-gallery.jpg` },
  { href: `${base}/events`,    label: 'Events & Classes',      bg: `${base}/images/nav-events.jpg` },
  { href: `${base}/live-art`,  label: 'Live Art Performance',  bg: `${base}/images/nav-live-art.jpg` },
  { href: `${base}/about`,     label: 'About the Artist',      bg: `${base}/images/nav-about.jpg` },
];
---

<Layout title="Holly Alaine Arts | Portfolio">
  <section class="hero hero--split">
    <div class="hero-text">
      <h1>Holly Alaine Staples</h1>
      <p class="hero-desc">Holly Alaine is an art educator, visual artist, live art performer, face and body painter, art historian and photographer! Available for custom art commissions, art education for all ages (workshops, group classes, 1 on 1 tutoring) and face/body painting in Ottawa, Ontario, Canada.</p>
    </div>
    <figure class="hero-image">
      <img src={featuredImage} alt="Holly Alaine Staples in her studio, surrounded by her artwork" />
    </figure>
  </section>

  <nav class="nav-grid" aria-label="Site sections">
    {navCards.map(({ href, label, bg }) => (
      <a href={href} class="nav-card" style={`--card-bg: url('${bg}')`}>
        <span class="nav-card__label">{label}</span>
      </a>
    ))}
  </nav>
</Layout>
