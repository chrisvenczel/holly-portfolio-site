---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { title = 'Holly Elaine Arts', description = 'Portfolio of paintings, drawings, and photography.' } = Astro.props;
const base = import.meta.env.BASE_URL;
const nav = [
  { href: base, label: 'Home' },
  { href: `${base}/gallery`.replace(/\/+/g, '/'), label: 'Art Gallery' },
  { href: `${base}/events`.replace(/\/+/g, '/'), label: 'Events & Classes' },
  { href: `${base}/live-art`.replace(/\/+/g, '/'), label: 'Live Art Performance' },
  { href: `${base}/about`.replace(/\/+/g, '/'), label: 'About' },
];
const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={base}>{title}</a>
      <nav>
        <ul>
          {nav.map(({ href, label }) => {
            const normalized = href.replace(/\/+$/, '') || '/';
            const isActive = currentPath === normalized;
            return (
              <li>
                <a href={href} aria-current={isActive ? 'page' : undefined}>{label}</a>
              </li>
            );
          })}
        </ul>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <section id="contact" class="contact">
        <div class="contact-grid">
          <div class="contact-body">
            <h2>Get in touch</h2>
            <p class="contact-lede">For commissions, classes, live art, or anything else — send a note.</p>

            <form
              class="contact-form"
              action="https://formspree.io/f/mvzeabge"
              method="POST"
            >
              <div class="field">
                <label for="contact-name">Name</label>
                <input id="contact-name" name="name" type="text" required autocomplete="name" />
              </div>

              <div class="field">
                <label for="contact-email">Email</label>
                <input id="contact-email" name="email" type="email" required autocomplete="email" />
              </div>

              <div class="field">
                <label for="contact-subject">Subject</label>
                <select id="contact-subject" name="subject">
                  <option value="Commission">Commission</option>
                  <option value="Art education / classes">Art education / classes</option>
                  <option value="Face / body painting">Face / body painting</option>
                  <option value="Live art performance">Live art performance</option>
                  <option value="Other">Other</option>
                </select>
              </div>

              <div class="field">
                <label for="contact-message">Message</label>
                <textarea id="contact-message" name="message" rows="5" required></textarea>
              </div>

              <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" aria-hidden="true" class="honeypot" />

              <button type="submit">Send message</button>
            </form>
          </div>
        </div>
      </section>
      <p class="site-footer__copy">&copy; {new Date().getFullYear()} {title}</p>
    </footer>
  </body>
</html>
