---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { title = 'Holly Elaine Arts', description = 'Portfolio of paintings, drawings, and photography.' } = Astro.props;
const base = import.meta.env.BASE_URL;
const nav = [
  { href: base, label: 'Home' },
  { href: `${base}/#gallery`.replace(/\/+/g, '/'), label: 'Gallery' },
  { href: `${base}/#contact`.replace(/\/+/g, '/'), label: 'Contact' },
];
const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={base}>{title}</a>
      <nav>
        <ul>
          {nav.map(({ href, label }) => {
            const normalized = href.replace(/\/+$/, '') || '/';
            const isActive = currentPath === normalized;
            return (
              <li>
                <a href={href} aria-current={isActive ? 'page' : undefined}>{label}</a>
              </li>
            );
          })}
        </ul>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <p>&copy; {new Date().getFullYear()} {title}</p>
    </footer>
  </body>
</html>
